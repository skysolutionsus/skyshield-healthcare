    "test:scsem-updater": "npx tsx scripts/test-scsem-updater.ts",
    "test": "npm run test:compliance-evidence && npm run test:benchmark-selection && npm run test:scsem-manifest && npm run test:scsem-column-schema && npm run test:scsem-analysis-coverage && npm run test:scsem-source-integrity && npm run test:runtime-hardening && npm run test:legacy-scsem-retirement && npm run test:user-management-security && npm run test:credential-lifecycle && npm run test:mfa-evidence-db && npm run test:bifrost-model-switch && npm run test:mobile-responsive-layout && npm run test:scsem-updater-lifecycle && npm run test:scsem-formula-translation && npm run test:scsem-issue-codes && npm run test:scsem-updater && npm run test:scsem-corpus-export && npm run test:scsem-corpus-add-control",
