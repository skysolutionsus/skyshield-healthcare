generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  COMPLIANCE_OFFICER
  AUDITOR
  VIEWER
}

enum IncidentStatus {
  OPEN
  INVESTIGATING
  REMEDIATION
  RESOLVED
  CLOSED
}

enum IncidentSeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum IncidentType {
  FTI_EXPOSURE
  PII_BREACH
  UNAUTHORIZED_ACCESS
  SYSTEM_COMPROMISE
  POLICY_VIOLATION
  AUTO_GENERATED
}

enum UpdateReviewStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  logo      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users              User[]
  incidents          Incident[]
  auditLogs          AuditLog[]
  invitations        Invitation[]
}

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  name           String
  passwordHash   String
  role           Role      @default(VIEWER)
  organizationId String
  lastLogin      DateTime?
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization       Organization        @relation(fields: [organizationId], references: [id])
  conversations      Conversation[]
  incidents          Incident[]          @relation("AssignedIncidents")
  createdIncidents   Incident[]          @relation("CreatedIncidents")
  incidentActivities IncidentActivity[]
  auditLogs          AuditLog[]
}

model Invitation {
  id             String   @id @default(cuid())
  email          String
  role           Role     @default(VIEWER)
  organizationId String
  token          String   @unique
  expiresAt      DateTime
  used           Boolean  @default(false)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
}

model Conversation {
  id         String   @id @default(cuid())
  userId     String
  title      String
  bookmarked Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id])
  messages Message[]
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  role           String   // 'user' or 'assistant'
  content        String
  citations      Json?    // Array of {section, page, text}
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

model SCSEMTemplate {
  id            String   @id @default(cuid())
  name          String
  category      String
  version       String?
  effectiveDate String?
  cisVersion    String?
  cisTechnology String?
  filePath      String
  controlCount  Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  updateReviews SCSEMUpdateReview[]
  sheets        SCSEMSheet[]
  changeLogs    SCSEMChangeLog[]
}

model SCSEMSheet {
  id         String   @id @default(cuid())
  templateId String
  sheetName  String
  sheetType  String   // "test_cases" | "dashboard" | "results" | "instructions" | "changelog" | "appendix" | "other"
  sheetIndex Int
  rawData    Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  template SCSEMTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  controls SCSEMControl[]
}

model SCSEMControl {
  id                    String   @id @default(cuid())
  sheetId               String
  rowIndex              Int
  testId                String
  nistId                String?
  nistControlName       String?
  testMethod            String?
  sectionTitle          String?
  description           String?
  testProcedures        String?
  expectedResults       String?
  actualResults         String?
  status                String?
  findingStatement      String?
  notesEvidence         String?
  criticality           String?
  issueCode             String?
  issueCodeDescription  String?
  cisBenchmarkRef       String?
  recommendationNum     String?
  rationale             String?
  impact                String?
  remediationProcedure  String?
  remediationStatement  String?
  capRequestStatement   String?
  riskRating            String?
  extraColumns          Json?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  sheet SCSEMSheet @relation(fields: [sheetId], references: [id], onDelete: Cascade)
}

model SCSEMChangeLog {
  id          String   @id @default(cuid())
  templateId  String
  version     String
  changeDate  DateTime
  description String
  changedBy   String?
  source      String   // "xlsx_import" | "cis_sync" | "manual"
  createdAt   DateTime @default(now())

  template SCSEMTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
}

model SCSEMUpdateReview {
  id               String             @id @default(cuid())
  templateId       String
  benchmarkId      String
  status           UpdateReviewStatus @default(PENDING)
  suggestedChanges Json
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  template  SCSEMTemplate       @relation(fields: [templateId], references: [id], onDelete: Cascade)
  benchmark CISBenchmarkVersion @relation(fields: [benchmarkId], references: [id], onDelete: Cascade)
}

model Incident {
  id              String           @id @default(cuid())
  organizationId  String
  title           String
  description     String
  type            IncidentType
  severity        IncidentSeverity
  status          IncidentStatus   @default(OPEN)
  assignedToId    String?
  createdById     String
  affectedSystems String?
  remediationPlan String?
  relatedSections Json?            // Related Pub 1075 sections
  dateDiscovered  DateTime         @default(now())
  dateOccurred    DateTime?
  resolvedAt      DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id])
  assignedTo   User?               @relation("AssignedIncidents", fields: [assignedToId], references: [id])
  createdBy    User                @relation("CreatedIncidents", fields: [createdById], references: [id])
  activities   IncidentActivity[]
}

model IncidentActivity {
  id         String   @id @default(cuid())
  incidentId String
  userId     String
  action     String
  details    String?
  createdAt  DateTime @default(now())

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id])
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?
  action         String
  resourceType   String?
  resourceId     String?
  metadata       Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User?        @relation(fields: [userId], references: [id])
}

model CISBenchmarkVersion {
  id             String   @id @default(cuid())
  technology     String
  currentVersion String
  releaseDate    DateTime
  changesSummary String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  updateReviews  SCSEMUpdateReview[]
}
