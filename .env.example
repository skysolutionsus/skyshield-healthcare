# Compose uses the `db` hostname. For host-run local development, change it to `localhost`.
POSTGRES_PASSWORD=""
DATABASE_URL=""
# Example after secret injection:
# DATABASE_URL="postgresql://postgres:the-url-safe-POSTGRES_PASSWORD@db:5432/irs_skyshield?schema=public"
# Generate with `openssl rand -base64 32`; placeholders are rejected at container startup.
AUTH_SECRET="generate-a-random-secret-here"
# Docker Compose requires NEXTAUTH_SECRET and maps it to AUTH_SECRET inside the container.
NEXTAUTH_SECRET="generate-the-same-random-secret-here"
AUTH_TRUST_HOST=true
NEXTAUTH_URL="https://your-app-domain.com"
BIFROST_API_KEY="sk-bf-placeholder"
BIFROST_BASE_URL="http://192.168.16.104:8080/v1"
BIFROST_MODEL="azure/claude-sonnet-4-6"
BIFROST_TITLE_MODEL="azure/claude-sonnet-4-6"
BIFROST_SCSEM_MODEL="azure/claude-sonnet-4-6"
BIFROST_EMBEDDING_MODEL="azure/text-embedding-ada-002"
# Analysis worker lease: default 1 hour; runtime clamps values to 1 minute–6 hours.
SCSEM_UPDATER_ANALYSIS_LEASE_TIMEOUT_MS=3600000
# One-shot bootstrap is run manually with `npm run users:bootstrap-admin` and
# refuses to run after any user exists. Do not inject these into normal startup.
BOOTSTRAP_ADMIN_EMAIL=""
BOOTSTRAP_ADMIN_NAME=""
BOOTSTRAP_ADMIN_PASSWORD=""
BOOTSTRAP_ORGANIZATION_NAME=""
BOOTSTRAP_ORGANIZATION_SLUG=""
BOOTSTRAP_CAN_MANAGE_CANONICAL_SCSEMS=false
# Destructive disposable-environment seed only: JSON object of email-to-password
# entries with a distinct strong password for every seeded identity.
SEED_USER_PASSWORDS_JSON=""
SEED_CAN_MANAGE_CANONICAL_SCSEMS=false
SEED_ALLOW_DESTRUCTIVE_RESET=false
CRON_SECRET="generate-a-separate-random-secret-here"
SCSEM_CRON_ORGANIZATION_ID="explicit-steward-enabled-organization-id"
# Supply exactly one through approved secret injection; never commit license XML.
CIS_LICENSE_XML_PATH="/run/secrets/cis-securesuite-license.xml"
# CIS_LICENSE_XML_BASE64="base64-encoded-license-xml"
